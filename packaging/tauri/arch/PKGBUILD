pkgname=smart-config-editor-tauri
pkgver=0.1.0
pkgrel=1
pkgdesc="Smart Config Editor (Tauri)"
arch=('x86_64')
url="https://example.local"
license=('MIT')
depends=('gtk3' 'webkit2gtk' 'libappindicator-gtk3' 'lsof')
makedepends=('nodejs' 'npm' 'rust' 'cargo')
source=("tauri-app")
sha256sums=('SKIP')

prepare() {
  rm -rf "$srcdir/tauri-app"
  cp -r "$startdir/tauri-app" "$srcdir/tauri-app"
}

build() {
  cd "${srcdir}/tauri-app"
  npm install
  npm run tauri build
}

package() {
  install -Dm755 "${srcdir}/tauri-app/src-tauri/target/release/smartconfig-tauri" "${pkgdir}/usr/bin/smart-config-editor"
  install -Dm644 "${startdir}/packaging/tauri/arch/smart-config-editor.desktop" "${pkgdir}/usr/share/applications/smart-config-editor.desktop"
  install -Dm644 "${srcdir}/tauri-app/src-tauri/icons/icon.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/smart-config-editor.png"
}
