{
  "productName": "Smart Config Editor",
  "version": "0.1.0",
  "identifier": "com.smartconfig.editor",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "excludeLibs": [
          "libwebkit2gtk-4.1.so.0",
          "libEGL.so.1",
          "libGL.so.1",
          "libGLdispatch.so.0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Smart Config Editor",
        "width": 1280,
        "height": 720,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  }
}
